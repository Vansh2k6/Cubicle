  "facts": [
    {
      "id": "F1",
      "owner": "maya",
      "weight": 5,
      "content": {
        "en": "You wrote that routing was included. Vansh had only raised it as a possible improvement; it was not estimated or agreed."
      },
      "triggers": [
        "asked_background",
        "asked_why_urgent"
      ],
      "leak_keywords": {
        "en": [
          "routing",
          "included",
          "possible improvement",
          "estimated",
          "agreed"
        ]
      },
      "unlock_question": {
        "en": "What had actually been agreed about routing?"
      },
      "paraphrase_questions": {
        "en": [
          "What exactly did I promise on routing?",
          "Why is this handover urgent?"
        ]
      }
    },
    {
      "id": "F2",
      "owner": "jordan",
      "weight": 6,
      "content": {
        "en": "The submission and storage piece is reusable, but that is all. Friday needs a reserved pair for the fix and QA; otherwise we can discuss core Friday with routing and dashboard followed up Monday."
      },
      "triggers": [
        "asked_for_help"
      ],
      "leak_keywords": {
        "en": [
          "submission",
          "storage",
          "reserved pair",
          "QA",
          "Monday",
          "dashboard"
        ]
      },
      "unlock_question": {
        "en": "What capacity and sequencing did Vansh need?"
      },
      "paraphrase_questions": {
        "en": [
          "What can we reuse?",
          "Can you reserve help for this plan?"
        ]
      }
    },
    {
      "id": "F3",
      "owner": "sam",
      "weight": 4,
      "content": {
        "en": "The success message can appear before the save is acknowledged. We need to fix and verify save, failure and retry on either route."
      },
      "triggers": [
        "asked_impact",
        "asked_advice"
      ],
      "leak_keywords": {
        "en": [
          "success message",
          "save acknowledgement",
          "failed save",
          "failure",
          "retry"
        ]
      },
      "unlock_question": {
        "en": "What must be fixed and verified before either route?"
      },
      "paraphrase_questions": {
        "en": [
          "What could make release unsafe?",
          "What should QA verify?"
        ]
      }
    },
    {
      "id": "F4",
      "owner": "client",
      "weight": 5,
      "content": {
        "en": "I asked about the dashboard because I thought submission and confirmation were already done. For Friday we need core business functionality and a receipt the customer can trust. Client operations can manually route only with instructions, a named owner and a Monday follow-up."
      },
      "triggers": [
        "asked_expectation"
      ],
      "leak_keywords": {
        "en": [
          "trustworthy receipt",
          "manual route",
          "instructions",
          "owner",
          "Monday follow-up",
          "dashboard"
        ]
      },
      "unlock_question": {
        "en": "What would client operations need for a manual route?"
      },
      "paraphrase_questions": {
        "en": [
          "What does the client need Friday?",
          "Could operations manually route?"
        ]
      }
    }
  ],
