# Server-side configuration; never put a credential in this file.
LLM_PROVIDER=offline
GROQ_API_KEY=
LLM_MAX_CALLS=40
LLM_MAX_TOKENS_TOTAL=60000
LLM_TPM_LIMIT=6000
CLASSIFIER_MODEL=openai/gpt-oss-20b
NPC_MODEL=qwen/qwen3.8-27b
JUDGE_MODEL=openai/gpt-oss-120b
COACH_MODEL=openai/gpt-oss-120b
# Optional per role: *_REASONING_EFFORT, *_MAX_TOKENS, *_EXTRA_PARAMS (JSON).
CLASSIFIER_REASONING_EFFORT=low
NPC_REASONING_EFFORT=none
JUDGE_REASONING_EFFORT=low
COACH_REASONING_EFFORT=low
RUN_LIVE=
VOICE_ENABLED=0
VITE_VOICE=0
VOICE_STT_DEVICE=auto
VOICE_STT_CHAIN=local
VOICE_TTS_CHAIN=local,browser
VOICE_LOCAL_URL=http://127.0.0.1:8790
VOICE_LOCAL_TOKEN=
VOICE_STT_TIMEOUT_MS=8000
VOICE_TTS_TIMEOUT_MS=6000
# Optional JSON map; keys and voice ids are validated against the local sidecar set.
VOICE_MAP_JSON=
